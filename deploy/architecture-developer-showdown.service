[Unit]
Description=Architecture Developer Showdown
After=network.target

[Service]
Type=simple
User=showdown
Group=showdown
WorkingDirectory=/var/www/architecture-developer-showdown/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3001
Environment=DATA_DIR=/var/lib/architecture-developer-showdown/data
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/architecture-developer-showdown/data

[Install]
WantedBy=multi-user.target
